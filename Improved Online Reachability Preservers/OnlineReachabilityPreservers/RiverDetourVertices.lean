import OnlineReachabilityPreservers.RiverDetourComponents

/-! Localize a short bridge using only the vertices of possible river detours. -/

namespace OnlineReachabilityPreservers

open Finset
local notation "Before" => SourceAudit.BeforeIn

/-- Strict comparisons from pieces other than the specified river. -/
def piecePrecedenceWithout {J V : Type*} [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V]
    (pieces : J → List V) (river : J) : Arcs V :=
  listPiecePrecedenceGraph (fun i => if i = river then [] else pieces i)

theorem piecePrecedenceWithout_edge {J V : Type*} [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V]
    {pieces : J → List V} {river : J} {x y : V} :
    Edge (piecePrecedenceWithout pieces river) x y ↔ ∃ i, i ≠ river ∧ Before pieces i x y := by
  rw [piecePrecedenceWithout,listPiecePrecedenceGraph_edge]
  constructor
  · rintro ⟨i,step⟩
    by_cases distinct : i ≠ river
    · exact ⟨i,distinct,by simpa only [SourceAudit.BeforeIn,ite_eq_right distinct] using step⟩
    · have same : i = river := not_ne_iff.mp distinct
      simp [SourceAudit.BeforeIn,same] at step
  · rintro ⟨i,distinct,step⟩
    exact ⟨i,by simpa only [SourceAudit.BeforeIn,ite_eq_right distinct] using step⟩

/-- The vertex `z` can lie on a walk of at most `k-1` strict steps from
a river's start to its end, with the river piece omitted. -/
def PieceRiverDetourThrough {J V : Type*} [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V]
    (pieces : J → List V) (k : ℕ) (x z : V) : Prop :=
  ∃ river, ∃ y, Before pieces river x y ∧
    ∃ r : Fin k, x ∈ reachIn (piecePrecedenceWithout pieces river) z r.val ∧
      z ∈ reachIn (piecePrecedenceWithout pieces river) y (k-1-r.val)

instance {J V : Type*} [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V]
    (pieces : J → List V) (k : ℕ) (x z : V) : Decidable (PieceRiverDetourThrough pieces k x z) := by
  unfold PieceRiverDetourThrough SourceAudit.BeforeIn
  infer_instance

/-- Join a river's start to all vertices of its bounded detour walks.
A strict comparison with no such detour contributes no edge. -/
def riverDetourVertexGraph {J V : Type*} [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V]
    (pieces : J → List V) (k : ℕ) : Arcs V :=
  univ.filter fun e => PieceRiverDetourThrough pieces k e.1 e.2 ∨ PieceRiverDetourThrough pieces k e.2 e.1

theorem riverDetourVertexGraph_edge {J V : Type*} [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V]
    {pieces : J → List V} {k : ℕ} {x y : V} :
    Edge (riverDetourVertexGraph pieces k) x y ↔
      PieceRiverDetourThrough pieces k x y ∨ PieceRiverDetourThrough pieces k y x := by
  simp only [Edge,riverDetourVertexGraph,mem_filter,mem_univ,true_and]

private theorem reachIn_fin_segment {V : Type*} [DecidableEq V] {G : Arcs V} {d : ℕ}
    (vertex : Fin (d+1) → V) (steps : ∀ i : Fin d, Edge G (vertex i.castSucc) (vertex i.succ))
    {a b : Fin (d+1)} (ordered : a ≤ b) :
    vertex a ∈ reachIn G (vertex b) (b.val-a.val) := by
  let segment (i : Fin (b.val-a.val+1)) : V := vertex ⟨a.val+i.val,by
    have below := i.isLt
    have last := b.isLt
    have first := Fin.le_iff_val_le_val.mp ordered
    omega⟩
  have on (i : Fin (b.val-a.val)) : Edge G (segment i.castSucc) (segment i.succ) := by
    have below : a.val+i.val < d := by
      have inside := i.isLt
      have last := b.isLt
      omega
    exact steps ⟨a.val+i.val,below⟩
  have first : segment 0 = vertex a := by simp [segment]
  have last : segment (Fin.last (b.val-a.val)) = vertex b := by
    unfold segment
    congr 1
    apply Fin.ext
    have before := Fin.le_iff_val_le_val.mp ordered
    simp only [Fin.val_last]
    omega
  simpa only [first,last] using reachIn_of_fin_steps segment on

private theorem reachIn_append_bound {V : Type*} [DecidableEq V] {G : Arcs V}
    {x y z : V} {a b : ℕ} (first : x ∈ reachIn G y a) (last : y ∈ reachIn G z b) :
    x ∈ reachIn G z (b+a) := by
  induction a generalizing x with
  | zero =>
    have eq : x = y := mem_singleton.mp first
    simpa only [Nat.add_zero,eq] using last
  | succ a ih =>
    rcases reachIn_succ.mp first with earlier | ⟨mid,edge,tail⟩
    · exact reachIn_subset_succ G z (b+a) (ih earlier)
    · exact reachIn_succ.mpr (Or.inr ⟨mid,edge,ih tail⟩)

/-- Every bridge through the cutoff stays in a single component of the
graph generated by the possible short river detours. -/
theorem Bridge.same_component_of_river_detour_vertices {J V : Type*}
    [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V]
    {pieces : J → List V} {k d : ℕ} (b : Bridge (Before pieces) d) (small : d+2 ≤ k)
    (i : Fin (d+2)) : SameComponent (riverDetourVertexGraph pieces k) (b.vertex i) (b.vertex 0) := by
  let G := piecePrecedenceWithout pieces b.river
  have steps (j : Fin (d+1)) : Edge G (b.vertex j.castSucc) (b.vertex j.succ) :=
    piecePrecedenceWithout_edge.mpr ⟨b.arc j,(b.river_ne_arc j).symm,b.arcStep j⟩
  let r : Fin k := ⟨i.val,by have := i.isLt; omega⟩
  have first : b.vertex 0 ∈ reachIn G (b.vertex i) r.val := by
    simpa only [Fin.val_zero,Nat.sub_zero] using reachIn_fin_segment b.vertex steps (Fin.zero_le i)
  let t := Fin.last (d+1)
  have bounds : t.val-i.val ≤ k-1-r.val := by
    have inside := i.isLt
    change d+1-i.val ≤ k-1-i.val
    omega
  have last := monotone_nat_of_le_succ (reachIn_subset_succ G (b.vertex t)) bounds
    (reachIn_fin_segment b.vertex steps (Fin.le_last i))
  have on : PieceRiverDetourThrough pieces k (b.vertex 0) (b.vertex i) :=
    ⟨b.river,b.vertex t,b.riverStep,r,first,last⟩
  exact ⟨.single (riverDetourVertexGraph_edge.mpr (Or.inr on)),
    .single (riverDetourVertexGraph_edge.mpr (Or.inl on))⟩

private theorem detour_vertex_same_constraint_component {J V : Type*}
    [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V]
    {pieces : J → List V} {k : ℕ} {x z : V} (window : PieceRiverDetourThrough pieces k x z) :
    SameComponent (riverDetourConstraintGraph pieces k) x z := by
  obtain ⟨river,y,on,r,first,last⟩ := window
  let G := riverDetourConstraintGraph pieces k
  have sub : piecePrecedenceWithout pieces river ⊆ G := by
    intro e edge
    obtain ⟨i,_,step⟩ := piecePrecedenceWithout_edge.mp (show Edge (piecePrecedenceWithout pieces river) e.1 e.2 from edge)
    exact riverDetourConstraintGraph_edge.mpr (.inl ⟨i,step⟩)
  have combined := reachIn_append_bound first last
  have length : k-1-r.val+r.val = k-1 := by have := r.isLt; omega
  rw [length] at combined
  have reverse : Edge G y x := riverDetourConstraintGraph_edge.mpr (.inr ⟨river,on,combined⟩)
  exact ⟨reach_mono sub (reachIn_sound first),(reach_mono sub (reachIn_sound last)).tail reverse⟩

/-- The components of the detour vertex graph refine the earlier constraint graph's
components. The original comparisons need not be included as edges. -/
theorem river_detour_vertices_refine_constraints {J V : Type*}
    [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V]
    {pieces : J → List V} {k : ℕ} {x y : V}
    (together : SameComponent (riverDetourVertexGraph pieces k) x y) :
    SameComponent (riverDetourConstraintGraph pieces k) x y := by
  have lift {a b : V} (route : Reach (riverDetourVertexGraph pieces k) a b) :
      SameComponent (riverDetourConstraintGraph pieces k) a b := by
    induction route with
    | refl => exact SameComponent.refl _ _
    | tail _ edge earlier =>
      rcases riverDetourVertexGraph_edge.mp edge with left | right
      · exact earlier.trans (detour_vertex_same_constraint_component left)
      · exact earlier.trans (detour_vertex_same_constraint_component right).symm
  exact lift together.1

/-- The detour vertex graph is empty if every strict comparison out of a vertex
comes from one piece. Removing that piece leaves no possible first step. -/
theorem riverDetourVertexGraph_eq_empty_of_unique_source_piece {J V : Type*}
    [DecidableEq J] [DecidableEq V] [Fintype J] [Fintype V] {pieces : J → List V}
    (unique : ∀ ⦃i j x y z⦄, Before pieces i x y → Before pieces j x z → i = j) (k : ℕ) :
    riverDetourVertexGraph pieces k = ∅ := by
  have noWindow {x z : V} (window : PieceRiverDetourThrough pieces k x z) : False := by
    obtain ⟨river,y,step,r,first,last⟩ := window
    let G := piecePrecedenceWithout pieces river
    have stop {v : V} (edge : Edge G x v) : False := by
      obtain ⟨i,apart,on⟩ := piecePrecedenceWithout_edge.mp edge
      exact apart (unique on step)
    have same (radius : ℕ) (reached : x ∈ reachIn G y radius) : x = y := by
      induction radius with
      | zero => exact mem_singleton.mp reached
      | succ depth ih =>
        rcases reachIn_succ.mp reached with earlier | ⟨_,edge,_⟩
        · exact ih earlier
        · exact (stop edge).elim
    exact listBefore_ne step (same _ (reachIn_append_bound first last))
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro e edge
  rcases riverDetourVertexGraph_edge.mp (show Edge (riverDetourVertexGraph pieces k) e.1 e.2 from edge) with on | on
  · exact noWindow on
  · exact noWindow on

/-- Check short returns on each component of the detour vertex graph.
The cutoff and the parent arrival order apply to both bridge modes. -/
theorem localOrderAdmissible_of_river_detour_vertex_returns {I J V : Type*}
    [LinearOrder I] [LinearOrder J] [LinearOrder V] [Fintype J] [Fintype V]
    {rows : I → List V} {pieces : J → List V} {k : ℕ} {half : Bool}
    (simple : ∀ i, (pieces i).Nodup) (parent : J → I) (arrival : Monotone parent)
    (steps : ∀ {i x y}, Before pieces i x y → Before rows (parent i) x y)
    (separated : ∀ c, let inner := listPiecesWithLabel pieces (componentLabel (riverDetourVertexGraph pieces k)) c
      ShortReturnSeparated (listPiecePrecedenceGraph inner) id rows inner parent (k-2))
    (legal : localOrderAdmissible half k rows) : localOrderAdmissible half k pieces :=
  localOrderAdmissible_of_labelwise_short_returns simple parent arrival
    (componentLabel (riverDetourVertexGraph pieces k)) (fun {_ _ _} => steps)
    (fun b small i => componentLabel_eq.mpr (b.same_component_of_river_detour_vertices small i))
    separated legal

/-- If same-parent pieces meet disjoint components of the detour vertex graph, the
within-component short-return tests hold without further constraints. -/
theorem localOrderAdmissible_of_river_detour_vertex_separation {I J V : Type*}
    [LinearOrder I] [LinearOrder J] [LinearOrder V] [Fintype J] [Fintype V]
    {rows : I → List V} {pieces : J → List V} {k : ℕ} {half : Bool}
    (simple : ∀ i, (pieces i).Nodup) (parent : J → I) (arrival : Monotone parent)
    (steps : ∀ {i x y}, Before pieces i x y → Before rows (parent i) x y)
    (apart : ∀ ⦃i j x y⦄, i ≠ j → parent i = parent j → x ∈ pieces i → y ∈ pieces j →
      ¬ SameComponent (riverDetourVertexGraph pieces k) x y)
    (legal : localOrderAdmissible half k rows) : localOrderAdmissible half k pieces := by
  apply localOrderAdmissible_of_river_detour_vertex_returns simple parent arrival (fun {_ _ _} => steps) _ legal
  intro c
  dsimp only
  intro i j different parents
  left
  intro x hx y hy
  rw [listPiecesWithLabel,List.mem_filter,decide_eq_true_eq] at hx hy
  exact (apart different parents hx.1 hy.1 (componentLabel_eq.mp (hx.2.trans hy.2.symm))).elim

/-- Bounded-detour components computed on the actual pieces permit
short-return cleaning at the two original widths. -/
theorem regularization_list_frozen_of_river_detour_vertex_returns {n p k : ℕ} {half : Bool}
    (paths : Fin p → List (Fin n)) (simple : ∀ i, (paths i).Nodup)
    (legal : let M := ∑ i, (paths i).length; localOrderAdmissible half k (splitListVertices paths (4*M/n)))
    (separated : let M := ∑ i, (paths i).length
      let copies := splitListVertices paths (4*M/n)
      let pieces := listRegularizedPaths paths (4*M/n) (4*M/p)
      ∀ c, let inner := listPiecesWithLabel pieces (componentLabel (riverDetourVertexGraph pieces k)) c
        ShortReturnSeparated (listPiecePrecedenceGraph inner) id copies inner (fun j => j.fst) (k-2))
    (hn : 0 < n) (hp : 0 < p) (dense : n ≤ ∑ i, (paths i).length) (long : p ≤ ∑ i, (paths i).length) :
    let M := ∑ i, (paths i).length
    ∃ n' ≤ n, ∃ p' ≤ p, ∃ clean : Fin p' → List (Fin n'),
      (∀ i, (clean i).Nodup) ∧ localOrderAdmissible half k clean ∧
      M ≤ 16*(∑ i, (clean i).length) ∧ (∑ i, (clean i).length) ≤ M ∧ frozenListCaps n p M clean := by
  let M := ∑ i, (paths i).length
  let copies := splitListVertices paths (4*M/n)
  let J := ListBlockIndex copies (4*M/p)
  let pieces := splitListPaths copies (4*M/p)
  have copySimple (i) : (copies i).Nodup := splitListVertices_simple paths _ i (simple i)
  have pieceSimple (i : J) : (pieces i).Nodup := List.filter_sublist.nodup (copySimple i.fst)
  have step {i : J} {x y} (before : Before pieces i x y) : Before copies i.fst x y :=
    listBefore_of_sublist (paths := fun j : J => copies j.fst) (copySimple i.fst) List.filter_sublist before
  have allowed : localOrderAdmissible half k pieces :=
    localOrderAdmissible_of_river_detour_vertex_returns pieceSimple (fun i : J => i.fst)
      (block_parent_mono (fun i => (copies i).toFinset) (4*M/p)) (fun {_ _ _} => step) separated legal
  exact regularization_list_frozen_after_width_blocks_of_mass (half := half) (retention := 16)
    paths simple allowed hn hp dense long le_rfl (by norm_num)

end OnlineReachabilityPreservers
