import DirectedFlowCutGap.CandidateNodeListsProgram

/-!
# Candidate descriptors from the stored vertex count and grid

Both label lists are generated by binary range enumeration. The level
list is obtained by incrementing the actual grid word before enumeration.
The descriptor builder consumes these returned lists.
-/

namespace DirectedFlowCutGap.CandidateInputNodeListsProgram

open BinaryArithmetic BooleanTableRead ImmutableReferenceSimulation ImmutableReferenceTerminal
open PackedBooleanConstructor
open ConcreteExpressionProgram (append_run)
open PathCostMaterialization (WordList list_extend)
open CandidateEnumeration (networkOrder)
open CandidateNodeListsProgram (Stored)

def rangeLabel (pc : Fin 65) : Fin 145 := ⟨16+pc.val,by omega⟩
def incrementLabel (pc : Fin 16) : Fin 145 := ⟨81+pc.val,by omega⟩
def nodesLabel (pc : Fin 48) : Fin 145 := ⟨97+pc.val,by omega⟩

def program : Program 145 := fun pc =>
  if pc.val<16 then
    match pc.val with
    | 0 => .call (rangeLabel 0) 1 .r2
    | 1 => .call 8 2 .r3
    | 2 => .move .r0 .r2 3
    | 3 => .move .r1 .r3 4
    | 4 => .call (nodesLabel 0) 5 .r3
    | 8 => .move .r0 .r1 9
    | 9 => .call (incrementLabel 15) 10 .r3
    | 10 => .move .r0 .r3 11
    | 11 => .call (rangeLabel 0) 12 .r3
    | 12 => .ret .r3
    | _ => .halt
  else if h : pc.val<81 then
    if pc.val=20 then .ret .r3
    else ReferenceProgramLabels.instruction rangeLabel (BinaryLabelRangeProgram.program ⟨pc.val-16,by omega⟩)
  else if h : pc.val<97 then
    if pc.val=95 then .ret .r3
    else ReferenceProgramLabels.instruction incrementLabel (BinaryIncrementProgram.program ⟨pc.val-81,by omega⟩)
  else if pc.val=108 then .ret .r3
  else ReferenceProgramLabels.instruction nodesLabel
    (CandidateNodeListsProgram.program ⟨pc.val-97,by have := pc.isLt; omega⟩)

def state (heap : NaturalHeap) (r : Registers ℕ) (stack : List (Frame ℕ 145))
    (tape : Bits) (pc : Fin 145) : NaturalState 145 := ⟨heap,heap.length,r,stack,pc,tape⟩

def steps (vertices grid : Bits) : ℕ :=
  BinaryLabelRangeProgram.steps vertices+BinaryIncrementProgram.steps grid+
    BinaryLabelRangeProgram.steps (increment true grid).1+CandidateNodeListsProgram.steps (value vertices) (value grid+1)+15

def instructionBound (n L verticesWidth gridWidth : ℕ) : ℕ :=
  CandidateNodeListsProgram.steps n (L+1)+n*(8*n.size+19)+(L+1)*(8*(L+1).size+19)+
    10*verticesWidth+18*gridWidth+48

theorem steps_le (vertices grid : Bits) :
    steps vertices grid ≤ instructionBound (value vertices) (value grid) vertices.length grid.length := by
  have verticesBound := BinaryLabelRangeProgram.steps_le vertices
  have incrementBound := BinaryIncrementProgram.steps_bound grid
  have levelsBound := BinaryLabelRangeProgram.steps_le (increment true grid).1
  have numeric : value (increment true grid).1=value grid+1 := (increment_spec true grid).1
  have width := (increment_spec true grid).2.1
  rw [numeric] at levelsBound
  unfold steps instructionBound
  omega

private theorem range_slots (pc : Fin 65) (h : BinaryLabelRangeProgram.program pc≠.halt) :
    program (rangeLabel pc)=ReferenceProgramLabels.instruction rangeLabel (BinaryLabelRangeProgram.program pc) := by
  by_cases hp : pc.val=4
  · have eq : pc=4 := Fin.ext hp
    subst pc
    exact (h rfl).elim
  · simp [program,rangeLabel,show ¬16+pc.val<16 by omega,show 16+pc.val<81 by omega,show 16+pc.val≠20 by omega]

private theorem increment_slots (pc : Fin 16) (h : BinaryIncrementProgram.program pc≠.halt) :
    program (incrementLabel pc)=ReferenceProgramLabels.instruction incrementLabel (BinaryIncrementProgram.program pc) := by
  by_cases hp : pc.val=14
  · have eq : pc=14 := Fin.ext hp
    subst pc
    exact (h rfl).elim
  · simp [program,incrementLabel,show ¬81+pc.val<16 by omega,show ¬81+pc.val<81 by omega,
      show 81+pc.val<97 by omega,show 81+pc.val≠95 by omega]

private theorem nodes_slots (pc : Fin 48) (h : CandidateNodeListsProgram.program pc≠.halt) :
    program (nodesLabel pc)=ReferenceProgramLabels.instruction nodesLabel (CandidateNodeListsProgram.program pc) := by
  by_cases hp : pc.val=11
  · have eq : pc=11 := Fin.ext hp
    subst pc
    exact (h rfl).elim
  · simp [program,nodesLabel,show ¬97+pc.val<16 by omega,show ¬97+pc.val<81 by omega,
      show ¬97+pc.val<97 by omega,show 97+pc.val≠108 by omega]

private theorem range_call {heap : NaturalHeap} {r : Registers ℕ} {count : Bits}
    (input : BoolList heap r.a count) (stack : List (Frame ℕ 145)) (tape : Bits)
    (pc next : Fin 145) (dest : Reg) (opcode : program pc=.call (rangeLabel 0) next dest) :
    ∃ ext root,WordList (heap++ext) root (BinaryLabelRangeProgram.wordsFrom 0 (value count)) ∧
      NaturalRun program (BinaryLabelRangeProgram.steps count+2) (state heap r stack tape pc) []
        (state (heap++ext) (r.set dest root) stack tape next) := by
  let frame : Frame ℕ 145 := ⟨next,dest,r⟩
  have enter : tickNatural program (state heap r stack tape pc)=some ⟨state heap r (frame::stack) tape (rangeLabel 0),[],0⟩ := by
    simp [state,tickNatural,frame,opcode]
  obtain ⟨ext,args,root,rep,body⟩ := BinaryLabelRangeProgram.natural_range input tape
  let stop := state (heap++ext) (args.set .r3 root) (frame::stack) tape (rangeLabel 4)
  have lifted := ReferenceProgramLabels.run rangeLabel BinaryLabelRangeProgram.program program range_slots body
  have lifted := ReferenceProgramStack.run program (frame::stack) lifted
  have run : NaturalRun program (BinaryLabelRangeProgram.steps count)
      (state heap r (frame::stack) tape (rangeLabel 0)) [] stop := by
    simpa [state,stop,BinaryLabelRangeProgram.state,ReferenceProgramLabels.state,ReferenceProgramStack.state] using lifted
  have ret : tickNatural program stop=some ⟨state (heap++ext) (r.set dest root) stack tape next,[],0⟩ := by
    simp [state,stop,program,rangeLabel,tickNatural,frame,Registers.get,Registers.set]
  exact ⟨ext,root,rep,.step enter (append_run run (.step ret (.done _)))⟩

private theorem increment_call {heap : NaturalHeap} {r : Registers ℕ} {grid : Bits}
    (input : BoolList heap r.b grid) (tape : Bits) :
    ∃ ext root,BoolList (heap++ext) root (increment true grid).1 ∧
      NaturalRun program (BinaryIncrementProgram.steps grid+5) (state heap r [] tape 1) []
        (state (heap++ext) ((r.set .r0 r.b).set .r3 root) [⟨2,.r3,r⟩] tape 10) := by
  let args := r.set .r0 r.b
  let outer : Frame ℕ 145 := ⟨2,.r3,r⟩
  let inner : Frame ℕ 145 := ⟨10,.r3,args⟩
  have setup : NaturalRun program 3 (state heap r [] tape 1) []
      (state heap args [inner,outer] tape (incrementLabel 15)) := by
    apply ReferenceProgramSteps.sound
    rfl
  obtain ⟨ext,root,len,body,rep⟩ := BinaryIncrementProgram.increment_return (a:=args.a) input heap.length
    args.b args.c args.d rfl args 14 [] tape
  have original : tickNatural BinaryIncrementProgram.program
      (BinaryIncrementProgram.state heap heap.length args.a args.b args.c args.d [] tape 15)=
      some ⟨BinaryIncrementProgram.state heap heap.length args.a args.b args.c args.d [⟨14,.r3,args⟩] tape 0,[],0⟩ := by
    cases r
    rfl
  let stop := state (heap++ext) (args.set .r3 root) [inner,outer] tape (incrementLabel 14)
  have lifted := ReferenceProgramLabels.run incrementLabel BinaryIncrementProgram.program program increment_slots (.step original body)
  have lifted := ReferenceProgramStack.run program [inner,outer] lifted
  have run : NaturalRun program (BinaryIncrementProgram.steps grid+1)
      (state heap args [inner,outer] tape (incrementLabel 15)) [] stop := by
    cases r
    simpa [state,stop,args,inner,BinaryIncrementProgram.state,ReferenceProgramLabels.state,
      ReferenceProgramStack.state,Registers.set,len] using lifted
  have ret : tickNatural program stop=some ⟨state (heap++ext) (args.set .r3 root) [outer] tape 10,[],0⟩ := by
    simp [state,stop,program,incrementLabel,tickNatural,inner,Registers.get,Registers.set]
  refine ⟨ext,root,rep,?_⟩
  have count : 3+(BinaryIncrementProgram.steps grid+1+1)=BinaryIncrementProgram.steps grid+5 := by omega
  rw [← count]
  exact append_run setup (append_run run (.step ret (.done _)))

private theorem levels_call {heap : NaturalHeap} {r : Registers ℕ} {grid : Bits} {L : ℕ}
    (input : BoolList heap r.b grid) (numeric : value grid=L) (tape : Bits) :
    ∃ ext root,WordList (heap++ext) root ((List.finRange (L+1)).map fun l => l.val.bits) ∧
      NaturalRun program (BinaryIncrementProgram.steps grid+BinaryLabelRangeProgram.steps (increment true grid).1+9)
        (state heap r [] tape 1) [] (state (heap++ext) (r.set .r3 root) [] tape 2) := by
  obtain ⟨ei,count,countWord,inc⟩ := increment_call input tape
  let mid := heap++ei
  let args := (r.set .r0 r.b).set .r3 count
  let ready := args.set .r0 count
  let caller : Frame ℕ 145 := ⟨2,.r3,r⟩
  have move : tickNatural program (state mid args [caller] tape 10)=some ⟨state mid ready [caller] tape 11,[],0⟩ := rfl
  obtain ⟨el,root,rep,body⟩ := range_call (r:=ready) countWord [caller] tape 11 12 .r3 rfl
  have ret : tickNatural program (state (mid++el) (ready.set .r3 root) [caller] tape 12)=
      some ⟨state (mid++el) (r.set .r3 root) [] tape 2,[],0⟩ := by
    simp [state,program,tickNatural,caller,Registers.get,Registers.set]
  have countValue : value (increment true grid).1=L+1 := by rw [(show value (increment true grid).1=value grid+1 from
      (increment_spec true grid).1),numeric]
  refine ⟨ei++el,root,?_,?_⟩
  · simpa only [countValue,BinaryLabelRangeProgram.words_fin,mid,List.append_assoc] using rep
  · let a := BinaryIncrementProgram.steps grid
    let b := BinaryLabelRangeProgram.steps (increment true grid).1
    have stepsEq : a+5+(b+2+1+1)=a+b+9 := by omega
    change NaturalRun program (a+b+9) _ [] _
    rw [← stepsEq]
    simpa only [mid,a,b,args,caller,List.append_assoc,List.nil_append,Nat.zero_add] using
      append_run inc (.step move (append_run body (.step ret (.done _))))

private theorem nodes_call {n L : ℕ} {heap : NaturalHeap} {r : Registers ℕ}
    (vertices : WordList heap r.c ((List.finRange n).map fun v => v.val.bits))
    (levels : WordList heap r.d ((List.finRange (L+1)).map fun l => l.val.bits)) (tape : Bits) :
    ∃ (ext : NaturalHeap) (args : Registers ℕ) (root : ℕ),Stored (heap++ext) root (networkOrder n L) ∧
      NaturalRun program (CandidateNodeListsProgram.steps n (L+1)+4)
        (state heap r [] tape 2) [] (state (heap++ext) (args.set .r3 root) [] tape 5) := by
  let args := (r.set .r0 r.c).set .r1 r.d
  let caller : Frame ℕ 145 := ⟨5,.r3,args⟩
  have setup : NaturalRun program 3 (state heap r [] tape 2) [] (state heap args [caller] tape (nodesLabel 0)) := by
    apply ReferenceProgramSteps.sound
    rfl
  obtain ⟨ext,regs,root,rep,body⟩ := CandidateNodeListsProgram.natural_nodes (r:=args) vertices levels tape
  let stop := state (heap++ext) (regs.set .r3 root) [caller] tape (nodesLabel 11)
  have lifted := ReferenceProgramLabels.run nodesLabel CandidateNodeListsProgram.program program nodes_slots body
  have lifted := ReferenceProgramStack.run program [caller] lifted
  let work := CandidateNodeListsProgram.steps n (L+1)
  have run : NaturalRun program work (state heap args [caller] tape (nodesLabel 0)) [] stop := by
    simpa [state,stop,work,CandidateNodeListsProgram.state,ReferenceProgramLabels.state,ReferenceProgramStack.state] using lifted
  have ret : tickNatural program stop=some ⟨state (heap++ext) (args.set .r3 root) [] tape 5,[],0⟩ := by
    simp [state,stop,program,nodesLabel,tickNatural,caller,Registers.get,Registers.set]
  refine ⟨ext,args,root,rep,?_⟩
  have total : 3+(work+1)=work+4 := by omega
  change NaturalRun program (work+4) _ [] _
  rw [← total]
  exact append_run setup (append_run run (.step ret (.done _)))

theorem natural_input_nodes {n L : ℕ} {heap : NaturalHeap} {r : Registers ℕ} {vertices grid : Bits}
    (size : BoolList heap r.a vertices) (scale : BoolList heap r.b grid)
    (numeric : value vertices=n) (gridValue : value grid=L) (tape : Bits) :
    ∃ (ext : NaturalHeap) (args : Registers ℕ) (root : ℕ),Stored (heap++ext) root (networkOrder n L) ∧
      NaturalRun program (steps vertices grid) (state heap r [] tape 0) []
        (state (heap++ext) (args.set .r3 root) [] tape 5) := by
  obtain ⟨ev,v,vs,verticesRun⟩ := range_call size [] tape 0 1 .r2 rfl
  rw [numeric,BinaryLabelRangeProgram.words_fin] at vs
  let mid := heap++ev
  let ready := r.set .r2 v
  obtain ⟨el,l,ls,levelsRun⟩ := levels_call (r:=ready) (boolList_extend scale ev) gridValue tape
  let grown := mid++el
  let args := ready.set .r3 l
  obtain ⟨en,regs,root,rep,build⟩ := nodes_call (r:=args) (list_extend vs el) ls tape
  refine ⟨ev++el++en,regs,root,?_,?_⟩
  · simpa only [grown,mid,List.append_assoc] using rep
  · let a := BinaryLabelRangeProgram.steps vertices
    let b := BinaryIncrementProgram.steps grid
    let c := BinaryLabelRangeProgram.steps (increment true grid).1
    let d := CandidateNodeListsProgram.steps n (L+1)
    have count : a+2+(b+c+9+(d+4))=a+b+c+d+15 := by omega
    unfold steps
    rw [numeric,gridValue]
    change NaturalRun program (a+b+c+d+15) _ [] _
    rw [← count]
    simpa only [grown,mid,ready,a,b,c,d,List.append_assoc,List.nil_append] using
      append_run verticesRun (append_run levelsRun build)

end DirectedFlowCutGap.CandidateInputNodeListsProgram
